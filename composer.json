{
    "name": "id-sign/business-registers",
    "description": "Typed PHP client for Czech business registers: ARES, VAT register (ADIS) and VIES.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ares", "adis", "vies", "vat", "dph", "ico", "dic", "czech"],
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "symfony/http-client-contracts": "^3.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": { "IdSign\\BusinessRegisters\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "IdSign\\BusinessRegisters\\Tests\\": "tests/" }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "test:live": "phpunit --testsuite live",
        "check": ["@cs", "@phpstan", "@test"]
    },
    "config": {
        "sort-packages": true
    }
}
